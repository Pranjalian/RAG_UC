# Backend Environment Variables
GOOGLE_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# Optional: Restrict API access from this frontend URL for production
# If left empty, API will allow all origins (*)
FRONTEND_URL=

# Secure token to authenticate the GitHub Actions ingestion trigger
ADMIN_TOKEN=your_secure_random_string_here
